# ============================================================
# AI Service — Environment Variable Reference
# ============================================================
# LOCAL DEVELOPMENT: copy this file to .env and fill in real values.
# HUGGING FACE SPACES: set these as "Repository Secrets" under
#   Space Settings → Variables and secrets
#   (do NOT commit .env with real values to git)
# ============================================================

# ------------------------------------------------------------
# Server (local dev only — HF Spaces ignores PORT/HOST)
# ------------------------------------------------------------
PORT=8000
HOST=0.0.0.0

# ------------------------------------------------------------
# AI Model Configuration
# ------------------------------------------------------------
# Sentence-BERT model from HuggingFace Hub (downloaded on first start)
AI_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
AI_MODEL_VERSION=1.1

# Routing confidence threshold (0.0–1.0). Below this → flagged_for_review
AI_CONFIDENCE_THRESHOLD=0.65

# Minimum score margin between top-1 and top-2 to auto-complete routing
AI_MARGIN_THRESHOLD=0.05

# Number of top department predictions to return
TOP_K=3

# ------------------------------------------------------------
# Internal Service Authentication  ← REQUIRED SECRET
# Bearer token that the Node.js backend must send to /api/v1/route
# Set as a Hugging Face Space secret: AI_SERVICE_SECRET
# ------------------------------------------------------------
AI_SERVICE_SECRET=your-internal-ai-service-secret-change-me

# ------------------------------------------------------------
# Supabase Credentials  ← REQUIRED SECRETS
# Read-only access to the departments table
# Set as Hugging Face Space secrets: SUPABASE_URL, SUPABASE_SECRET_KEY
# ------------------------------------------------------------
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SECRET_KEY=your-supabase-service-role-key
