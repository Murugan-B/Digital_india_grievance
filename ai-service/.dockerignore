# ============================================================
# .dockerignore — ai-service
# Keeps the Docker build context lean and safe.
# ============================================================

# --- Secrets (NEVER ship into image) ---
.env
.env.local
.env.*.local

# --- Python virtual environment ---
venv/
env/
ENV/
.venv/

# --- Python bytecode cache ---
**/__pycache__/
**/*.pyc
**/*.pyo
**/*.pyd
.Python

# --- Test infrastructure (not needed at runtime) ---
tests/
test_live_routing.py
.pytest_cache/
**/.pytest_cache/

# --- Git ---
.git/
.gitignore

# --- IDE / editor files ---
.vscode/
.idea/
*.swp
*.swo

# --- HuggingFace / model cache (downloaded fresh inside container) ---
.cache/
hf_cache/

# --- Documentation (not required at runtime) ---
README.md
*.md

# --- Build / dist artifacts ---
*.egg-info/
dist/
build/
